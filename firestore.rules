rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Entity Validators
    function isValidUser(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.email is string && data.email.size() > 0 && data.email.size() <= 150;
    }

    function isValidTransaction(data, userId) {
      return data.userId == userId &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 120 &&
             data.category is string && data.category.size() > 0 && data.category.size() <= 50 &&
             data.amount is number &&
             data.date is string &&
             data.type in ['expense', 'income', 'investment', 'transfer'] &&
             data.status in ['completed', 'pending'];
    }

    function isValidBudget(data, userId) {
      return data.userId == userId &&
             data.category is string && data.category.size() > 0 && data.category.size() <= 50 &&
             data.limit is number && data.limit >= 0 &&
             data.spent is number && data.spent >= 0 &&
             data.month is string;
    }

    function isValidCard(data, userId) {
      return data.userId == userId &&
             data.bankName is string && data.bankName.size() > 0 && data.bankName.size() <= 80 &&
             data.cardNumber is string && data.cardNumber.size() > 0 && data.cardNumber.size() <= 30 &&
             data.cardHolderName is string && data.cardHolderName.size() > 0 && data.cardHolderName.size() <= 80 &&
             data.cardBrand in ['Mastercard', 'Visa', 'Elo'];
    }

    function isValidAccount(data, userId) {
      return data.userId == userId &&
             data.institutionName is string && data.institutionName.size() > 0 && data.institutionName.size() <= 80 &&
             data.institutionCode is string && data.institutionCode.size() > 0 && data.institutionCode.size() <= 20 &&
             data.balance is number;
    }

    function isValidAsset(data, userId) {
      return data.userId == userId &&
             data.ticker is string && data.ticker.size() > 0 && data.ticker.size() <= 20 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.currentPrice is number && data.currentPrice >= 0 &&
             data.quantity is number && data.quantity >= 0 &&
             data.averagePrice is number && data.averagePrice >= 0;
    }

    function isValidNotification(data, userId) {
      return data.userId == userId &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 100 &&
             data.description is string && data.description.size() <= 300 &&
             data.read is bool;
    }

    // Root User Document
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidUser(incoming());
      allow delete: if isOwner(userId);

      // Subcollection: Transactions
      match /transactions/{transactionId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(transactionId) && isValidTransaction(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(transactionId) && isValidTransaction(incoming(), userId) && incoming().userId == existing().userId;
        allow delete: if isOwner(userId) && isValidId(transactionId);
      }

      // Subcollection: Budgets
      match /budgets/{budgetId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(budgetId) && isValidBudget(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(budgetId) && isValidBudget(incoming(), userId) && incoming().userId == existing().userId;
        allow delete: if isOwner(userId) && isValidId(budgetId);
      }

      // Subcollection: Cards
      match /cards/{cardId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(cardId) && isValidCard(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(cardId) && isValidCard(incoming(), userId) && incoming().userId == existing().userId;
        allow delete: if isOwner(userId) && isValidId(cardId);
      }

      // Subcollection: Accounts
      match /accounts/{accountId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(accountId) && isValidAccount(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(accountId) && isValidAccount(incoming(), userId) && incoming().userId == existing().userId;
        allow delete: if isOwner(userId) && isValidId(accountId);
      }

      // Subcollection: Assets
      match /assets/{assetId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(assetId) && isValidAsset(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(assetId) && isValidAsset(incoming(), userId) && incoming().userId == existing().userId;
        allow delete: if isOwner(userId) && isValidId(assetId);
      }

      // Subcollection: Notifications
      match /notifications/{notificationId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(notificationId) && isValidNotification(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(notificationId) && isValidNotification(incoming(), userId) && incoming().userId == existing().userId;
        allow delete: if isOwner(userId) && isValidId(notificationId);
      }
    }
  }
}
